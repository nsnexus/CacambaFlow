rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se o usuário autenticado pertence ao tenant do caminho
    function isSameTenant(tenantId) {
      return isAuthenticated()
             && firestore.get(/databases/(default)/documents/profiles/$(request.auth.uid)).data.tenant_id == tenantId;
    }

    // As evidências ficam em /evidences/{tenantId}/{orderId}/{jobId}/{filename}
    match /evidences/{tenantId}/{allPaths=**} {

      // Só quem pertence ao mesmo tenant pode ler as evidências
      allow read: if isSameTenant(tenantId);

      // Só quem pertence ao mesmo tenant pode subir, e apenas imagens
      allow write: if isSameTenant(tenantId)
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
