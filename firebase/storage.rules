rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se o usuário autenticado pertence ao tenant do caminho.
    // Usa o custom claim do token (não firestore.get() cruzando serviço —
    // isso falhava com "unauthorized" mesmo pro tenant certo, o mesmo tipo
    // de problema já visto nas regras do Firestore com consultas em lista).
    function isSameTenant(tenantId) {
      return isAuthenticated() && request.auth.token.tenant_id == tenantId;
    }

    // As evidências ficam em /evidences/{tenantId}/{orderId}/{jobId}/{filename}
    match /evidences/{tenantId}/{allPaths=**} {

      // Só quem pertence ao mesmo tenant pode ler as evidências
      allow read: if isSameTenant(tenantId);

      // Só quem pertence ao mesmo tenant pode subir, e apenas imagens
      allow write: if isSameTenant(tenantId)
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
