rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar autenticação
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Tenant do usuário via custom claim do token (NÃO usar get() aqui: nas
    // consultas em lista/collectionGroup do app mobile, um get() pra outra
    // coleção faz o Firestore negar a query inteira com
    // "Missing or insufficient permissions" — confirmado empiricamente).
    // O custom claim "tenant_id" é setado no Auth (Admin SDK) na criação do
    // usuário; ver setCustomUserClaims em createDriver/seed.
    function getUserTenant() {
      return request.auth.token.tenant_id;
    }
    
    // Função auxiliar para verificar tenant match (Multi-tenant SaaS)
    function isSameTenant(resourceData) {
      return resourceData.tenant_id == getUserTenant();
    }
    
    // Profiles
    match /profiles/{profileId} {
      // Usuário pode ler o próprio perfil
      allow read: if isAuthenticated() && request.auth.uid == profileId;
      // Painel web (Admin SDK) gerencia a escrita, clientes não criam sozinhos (segurança)
      allow write: if false; 
    }
    
    // Outras coleções - leitura apenas se pertencer ao mesmo tenant
    match /customers/{customerId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow write: if false; // Gerenciado via Server Actions (Admin SDK)
      
      match /addresses/{addressId} {
        allow read: if isAuthenticated() && isSameTenant(resource.data);
        allow write: if false;
      }
    }
    
    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow write: if false;
    }
    
    // Usa {path=**} (em vez de um match direto) porque o app mobile consulta
    // esta coleção via collectionGroup() — sem o wildcard, o Firestore nega
    // a query inteira com "Missing or insufficient permissions", mesmo com
    // os documentos vivendo só no nível raiz.
    match /{path=**}/drivers/{driverId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      // Motorista pode escolher o próprio veículo atual pelo app (apenas
      // esse campo — o resto do cadastro é gerenciado só pelo painel web).
      allow update: if isAuthenticated()
                    && isSameTenant(resource.data)
                    && resource.data.profile_id == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['current_vehicle_id', 'updated_at']);
      allow create, delete: if false;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow write: if false;

      match /jobs/{jobId} {
        allow read: if isAuthenticated() && isSameTenant(resource.data);

        // Motoristas podem atualizar os status dos trabalhos deles (via app móvel)
        allow update: if isAuthenticated()
                      && isSameTenant(resource.data)
                      && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'failure_note']));

        allow create, delete: if false;
      }
    }

    // Mesmas regras de /orders/{orderId}/jobs/{jobId} acima, mas usando
    // {path=**} pra autorizar as consultas collectionGroup('jobs') que o
    // app mobile faz (ex: "meus atendimentos de hoje").
    match /{path=**}/jobs/{jobId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow update: if isAuthenticated()
                    && isSameTenant(resource.data)
                    && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'failure_note']));
      allow create, delete: if false;
    }
    
    // Caçambas (unidades físicas). O painel web gerencia o cadastro via
    // Admin SDK; o app mobile só pode marcar como entregue/localizada ao
    // concluir um atendimento de entrega/troca.
    match /assets/{assetId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow update: if isAuthenticated()
                    && isSameTenant(resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'customer_id', 'address_id', 'delivered_at', 'delivery_latitude', 'delivery_longitude']);
      allow create, delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow write: if false;
    }

    // Evidências (fotos) capturadas pelo app do motorista
    match /evidences/{evidenceId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow create: if isAuthenticated()
                    && isSameTenant(request.resource.data)
                    && request.resource.data.created_by == request.auth.uid;
      allow update, delete: if false;
    }

    // Posições de GPS reportadas pelo app do motorista
    match /driver_locations/{locationId} {
      allow read: if isAuthenticated() && isSameTenant(resource.data);
      allow create: if isAuthenticated() && isSameTenant(request.resource.data);
      allow update, delete: if false;
    }
  }
}
